# ===== LLM（OpenAI 兼容接口，DeepSeek / 通义 / Moonshot 等均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# ===== Embedding（base_url / api_key 留空时回退到 LLM 的配置）=====
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ===== 向量库 =====
CHROMA_PERSIST_DIR=./data/chroma
RAG_TOP_K=4

# ===== 服务 =====
APP_PORT=8000
LOG_LEVEL=INFO
